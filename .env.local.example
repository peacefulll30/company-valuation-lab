# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored (see .gitignore) — it will never be committed.

# Anthropic Console → API Keys → Create Key
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Upstash Console → your Redis database → REST API section
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twelve Data → sign up (free tier: 800 requests/day) → API key
# https://twelvedata.com/pricing
# Powers the live market price shown next to a company's name and used to
# weight WACC by market value of equity. Without this, the app behaves
# exactly as before: "Price unavailable", cost-of-equity used as the WACC
# proxy — never a fabricated price.
#
# Licensing: displaying this data in production or to the public is subject
# to Twelve Data's terms of use (https://twelvedata.com/terms) — confirm
# your plan's redistribution/display terms permit the deployment before
# shipping this beyond local development.
TWELVE_DATA_API_KEY=
